(ns minii-focus.logic.anniversary
  (:require ["dart:core" :as dc]
            ["package:lunar/lunar.dart" :as l]))

(defn- pad2 [n]
  (let [s (str n)]
    (if (< n 10) (str "0" s) s)))

(defn solar-date-key
  "Format DateTime into YYYY-MM-DD key."
  [^dc/DateTime dt]
  (str (.-year dt) "-" (pad2 (.-month dt)) "-" (pad2 (.-day dt))))

(defn lunar->solar-in-lunar-year
  "Directly convert a lunar month/day in a given lunar year to solar DateTime.
   Handles leap-month fallback and 30->29 small-month fallback in O(1) time."
  [target-lunar-year lunar-month lunar-day is-leap?]
  (let [leap-m    (l/LunarYear.fromYear target-lunar-year)
        has-leap? (= (.getLeapMonth leap-m) lunar-month)
        eff-month (if (and is-leap? has-leap?) (- lunar-month) lunar-month)
        l-month   (l/LunarMonth.fromYm target-lunar-year eff-month)]
    (when l-month
      (let [max-day  (.getDayCount l-month)
            safe-day (min lunar-day max-day)
            l-date   (l/Lunar.fromYmd target-lunar-year eff-month safe-day)
            solar    (.getSolar l-date)]
        (dc/DateTime. (.getYear solar) (.getMonth solar) (.getDay solar))))))

(defn get-anniversaries-for-solar-year
  "Resolve all lunar anniversaries that fall within a given Gregorian solar year."
  [solar-year anniversary-list]
  (reduce
   (fn [acc ann]
     (let [m     (:lunar-month ann)
           d     (:lunar-day ann)
           leap? (boolean (:is-leap-month? ann))
           candidates (keep #(lunar->solar-in-lunar-year % m d leap?)
                            [(dec solar-year) solar-year])
           matched    (filter #(= (.-year ^dc/DateTime %) solar-year) candidates)]
       (into acc
             (map (fn [^dc/DateTime s-dt]
                    (let [age (when-let [by (:lunar-year ann)]
                                (- (.-year s-dt) by))]
                      (assoc ann
                             :solar-date s-dt
                             :solar-year solar-year
                             :years-count age)))
                  matched))))
   []
   anniversary-list))

(defn anniversaries-by-date-key
  "Build {'YYYY-MM-DD' [anniversary-maps...]} for a solar year."
  [solar-year anniversary-list]
  (let [computed (get-anniversaries-for-solar-year solar-year anniversary-list)]
    (reduce
     (fn [m ann]
       (update m (solar-date-key (:solar-date ann))
               (fn [v] (conj (or v []) ann))))
     {}
     computed)))

(defn next-occurrence
  "Calculate the next upcoming solar DateTime and days remaining from `today`."
  [ann ^dc/DateTime today]
  (let [base-today (dc/DateTime. (.-year today) (.-month today) (.-day today))
        cur-year   (.-year base-today)
        m          (:lunar-month ann)
        d          (:lunar-day ann)
        leap?      (boolean (:is-leap-month? ann))
        dates      (keep #(lunar->solar-in-lunar-year % m d leap?)
                         [(dec cur-year) cur-year (inc cur-year)])
        upcoming   (first (filter #(not (.isBefore ^dc/DateTime % base-today))
                                  (sort #(compare %1 %2) dates)))]
    (when upcoming
      (let [days-left (.-inDays (.difference ^dc/DateTime upcoming base-today))
            age       (when-let [by (:lunar-year ann)]
                        (- (.-year upcoming) by))]
        (assoc ann
               :next-solar-date upcoming
               :days-left days-left
               :years-count age)))))

(defn upcoming-anniversaries
  "Return anniversaries sorted by days-left (e.g., within next 30 days)."
  [anniversary-list ^dc/DateTime today max-days]
  (->> anniversary-list
       (keep #(next-occurrence % today))
       (filter #(<= (:days-left %) max-days))
       (sort-by :days-left)
       vec))
