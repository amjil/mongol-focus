(ns minii-focus.logic.records
  (:require ["dart:core" :as dc]
            [clojure.string :as str]))

(def ^:private sql-field->kw
  {"id" :id
   "title" :title
   "notes" :notes
   "is_done" :is-done?
   "subtask_count" :subtask-count
   "subtask_done_count" :subtask-done-count
   "category_id" :category-id
   "category_name" :category-name
   "category_icon" :category-icon
   "due_date" :due-date
   "reminder_at" :reminder-at
   "priority" :priority
   "recurrence_mode" :recurrence-mode
   "parent_id" :parent-id
   "parent_title" :parent-title
   "name" :name
   "icon_code" :icon-code
   "position" :position
   "completed_at" :completed-at
   "created_at" :created-at
   "display_order" :display-order
   ;; Anniversary SQL snake_case column mappings
   "is_solar" :is-solar?
   "lunar_year" :lunar-year
   "lunar_month" :lunar-month
   "lunar_day" :lunar-day
   "is_leap_month" :is-leap-month?
   "advance_days" :advance-days})

(defn- bool-value [v]
  (cond
    (nil? v) false
    (boolean? v) v
    (number? v) (not (zero? v))
    :else (boolean v)))

(defn- field-key [k]
  (if (keyword? k)
    k
    (get sql-field->kw (name k)
         (keyword (str/replace (name k) "_" "-")))))

(defn- normalize-entry [[k v]]
  (let [kw  (field-key k)
        val (if (contains? #{:is-done? :is-solar? :is-leap-month?} kw)
              (bool-value v)
              v)]
    [kw val]))

(defn ->clj
  "Convert a Drift/Dart map (string keys) into a Clojure map with keyword keys."
  [m]
  (when m
    (let [raw (if (and (map? m) (every? keyword? (keys m)))
                m
                (into {} m))]
      (into {} (map normalize-entry raw)))))

(defn row->anniversary
  "Convert Drift Anniversary DataClass, QueryRow, or Clojure map into normalized Anniversary map."
  [row]
  (cond
    (nil? row) nil

    (map? row)
    (let [is-solar? (bool-value (or (:is-solar? row) (= (:calendar-type row) :solar)))
          m         (or (:month row) (:lunar-month row) 1)
          d         (or (:day row) (:lunar-day row) 1)]
      (assoc row
             :type          (keyword (or (:type row) "birthday"))
             :calendar-type (if is-solar? :solar :lunar)
             :is-solar?     is-solar?
             :month         m
             :day           d
             :lunar-month   m
             :lunar-day     d))

    :else
    (let [is-solar? (try (bool-value (.-isSolar row)) (catch dc/Object _ false))
          m         (or (try (.-month row) (catch dc/Object _ nil))
                        (try (.-lunarMonth row) (catch dc/Object _ 1)))
          d         (or (try (.-day row) (catch dc/Object _ nil))
                        (try (.-lunarDay row) (catch dc/Object _ 1)))]
      {:id             (.-id row)
       :title          (.-title row)
       :type           (keyword (or (.-type row) "birthday"))
       :calendar-type  (if is-solar? :solar :lunar)
       :is-solar?      is-solar?
       :month          m
       :day            d
       :lunar-year     (try (.-lunarYear row) (catch dc/Object _ nil))
       :lunar-month    m
       :lunar-day      d
       :is-leap-month? (try (bool-value (.-isLeapMonth row)) (catch dc/Object _ false))
       :advance-days   (try (or (.-advanceDays row) 3) (catch dc/Object _ 3))})))

(defn anniversary-rows->maps [rows]
  (if (nil? rows)
    []
    (mapv row->anniversary rows)))

(defn row->clj
  "Convert either a customSelect QueryRow (has .-data) or a typed Drift DataClass row into a Clojure map."
  [row]
  (cond
    (nil? row) nil
    (map? row) (->clj row)
    :else
    (let [data (try (.-data row) (catch dc/Object _ ::no-data))]
      (if (= data ::no-data)
        (row->anniversary row)
        (let [m (->clj data)]
          (if (or (contains? m :lunar-month) (contains? m :is-solar?))
            (row->anniversary m)
            m))))))

(defn rows->clj [rows]
  (if (nil? rows)
    []
    (mapv row->clj rows)))

(defn task-done? [task]
  (:is-done? (->clj task)))
