(ns minii-focus.main
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/foundation.dart" :refer [kIsWeb]]
   ["package:flutter_dotenv/flutter_dotenv.dart" :as dotenv]
   ["package:cljd_mongol_focus/route_generator.dart" :as route-gen]
   [cljd.flutter :as f]
   [virtual-keyboard.options :as keyboard-options]
   [virtual-keyboard.input-control :as control]
   [ime-core.fst-engine :as fst-engine]
   [ime-core.next-word :as next-word]
   [minii-focus.logic.db :as db]
   [minii-focus.logic.notification :as notification]
   [minii-focus.logic.stats :as stats]
   [minii-focus.pages.home :as home]
   [minii-focus.state.store :as store]))

(defn- app-theme [font-family dark?]
  (if dark?
    (m/ThemeData
     .primarySwatch m/Colors.blue
     .fontFamily font-family
     .useMaterial3 true
     .brightness m/Brightness.dark)
    (m/ThemeData
     .primarySwatch m/Colors.blue
     .fontFamily font-family
     .useMaterial3 true)))

(defn init-app! []
  (control/set-control)

  (when-not kIsWeb
    (await (next-word/ensure-loaded))
    (await (fst-engine/ensure-loaded)))

  (await (notification/init!))
  (await (notification/request-permissions!))
  (await (db/initialize-database!))
  (await (store/load-settings!))
  (await (stats/report-daily!)))

(defn main []
  (m.WidgetsFlutterBinding/ensureInitialized)
  (await (.load dotenv/dotenv .fileName "assets/.env"))
  (await (init-app!))

  (f/run
   (f/widget
    :watch [state store/app-ui-state]
    :let [font-size (get-in state [:settings :font-size])
          font-family (get-in state [:settings :font-family])
          dark-mode? (get-in state [:settings :dark-mode?])
          text-scale (store/text-scale font-size)
          info (merge keyboard-options/keyboard-option
                      {:keyboard/key-cap-border-radius 6
                       :keyboard/font-size (* 18.0 text-scale)
                       :keyboard/key-container-color m/Colors.grey.shade500
                       :keyboard/mongol-font-family font-family})]
    :bind {:info info}

    (m/MaterialApp
     .themeMode (if dark-mode? m/ThemeMode.dark m/ThemeMode.light)
     .theme (app-theme font-family false)
     .darkTheme (app-theme font-family true)
     .builder (fn [ctx child]
                (let [media (m/MediaQuery.of ctx)]
                  (m/MediaQuery
                   .data (.copyWith media .textScaleFactor text-scale)
                   .child child)))
     .home (home/home-page)
     .onGenerateRoute route-gen/appOnGenerateRoute))))
