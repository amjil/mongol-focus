(ns minii-focus.pages.home
  (:require [cljd.flutter :as f]
            ["package:flutter/material.dart" :as m]
            ["package:cljd_mongol_focus/post_frame_trigger.dart" :as pft]
            [minii-focus.state.store :as store]
            [minii-focus.widgets.main-list :as main-list]
            [minii-focus.widgets.bottom-nav :as nav]
            [minii-focus.widgets.fab :as fab]
            [minii-focus.widgets.app-drawer :as drawer]
            [minii-focus.widgets.search-button :as search-button]
            [minii-focus.pages.settings :as settings]
            [minii-focus.pages.calendar-page :as calendar-page]
            [minii-focus.pages.anniversary-management :as anniversary-page]
            [minii-focus.widgets.calendar.dialogs :as cal-dialogs]
            [minii-focus.logic.db :as db]
            [minii-focus.logic.task-actions :as actions]
            [minii-focus.logic.update :as update]
            ["dart:core" :as dc]))

(defn- nav-shows-search? [selected-nav-id]
  (not (#{store/nav-settings store/nav-calendar store/nav-anniversary} selected-nav-id)))

(defn- page-body [scroll-controller selected-nav-id]
  (case selected-nav-id
    "calendar"
    (m/Container.
     .key (m/ValueKey. "page-calendar")
     .child (calendar-page/calendar-page {:embedded? true}))

    "anniversary"
    (m/Container.
     .key (m/ValueKey. "page-anniversary")
     .child (anniversary-page/anniversary-management-page {:embedded? true}))

    "today"
    (m/Container.
     .key (m/ValueKey. "page-today")
     .child (main-list/task-stream-view {:scroll-controller scroll-controller :mode :today}))

    "logbook"
    (m/Container.
     .key (m/ValueKey. "page-logbook")
     .child (main-list/task-stream-view {:scroll-controller scroll-controller :mode :logbook}))

    "settings"
    (m/Container.
     .key (m/ValueKey. "page-settings")
     .child (settings/settings-page))

    (m/Container.
     .key (m/ValueKey. "page-today-fallback")
     .child (main-list/task-stream-view {:scroll-controller scroll-controller :mode :today}))))

(defn home-page []
  (f/widget
   :context ctx
   :let [scroll-controller (m/ScrollController.)]
   :watch [{:keys [selected-nav-id]} store/app-ui-state]
   :get {{{bg .-surface} .-colorScheme} m/Theme}

   (pft/PostFrameTrigger
    .onLayout #(update/ensure-startup-check! ctx)
    .child
    (m/Scaffold.
     .appBar (m/AppBar.
              .actions (when (nav-shows-search? selected-nav-id)
                         [(search-button/filter-aware-search-button)]))
     .backgroundColor bg
     .drawer (drawer/main-drawer)
     .body
     (m/SafeArea.
      .child
      (m/AnimatedSwitcher.
       .duration (dc/Duration. .milliseconds 300)
       .transitionBuilder (fn [child animation]
                            (m/FadeTransition. .opacity animation .child child))
       .child (page-body scroll-controller selected-nav-id)))
     .bottomNavigationBar (nav/main-navigation-bar)
     .floatingActionButton
     (cond
       (= selected-nav-id store/nav-today)
       (fab/task-fab
        {:scroll-controller scroll-controller
         :on-pressed (fn [] (actions/open-task-editor ctx))})

       (= selected-nav-id store/nav-calendar)
       (f/widget
        :watch [{:keys [selected-date]} calendar-page/calendar-ui-state]
        (m/FloatingActionButton.
         .onPressed #(calendar-page/show-add-task-for-date-dialog! ctx selected-date)
         .child (m/Icon. m/Icons.add)))

       (= selected-nav-id store/nav-anniversary)
       (m/FloatingActionButton.
        .backgroundColor m/Colors.pinkAccent
        .foregroundColor m/Colors.white
        .onPressed #(cal-dialogs/show-add-anniversary-dialog!
                     ctx
                     (dc/DateTime.now)
                     (fn [m] (db/add-anniversary! m)))
        .child (m/Icon. m/Icons.add))

       :else (m/SizedBox.shrink))))))
