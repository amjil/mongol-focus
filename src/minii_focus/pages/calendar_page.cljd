(ns minii-focus.pages.calendar-page
  (:require ["dart:core" :as dc]
            ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [minii-focus.logic.task :as task-logic]
            [minii-focus.logic.anniversary :as ann]
            [minii-focus.logic.db :as db]
            [minii-focus.logic.stream-util :as stream-util]
            [minii-focus.widgets.calendar.state :as cal-state]
            [minii-focus.widgets.calendar.theme :as cal-theme]
            [minii-focus.widgets.calendar.dates :as cal-dates]
            [minii-focus.widgets.calendar.dialogs :as cal-dialogs]
            [minii-focus.widgets.calendar.body :as cal-body]))

;; Re-exports for home FAB and other callers
(def calendar-ui-state cal-state/calendar-ui-state)

(defn show-add-task-for-date-dialog!
  [ctx ^dc/DateTime target-date]
  (cal-dialogs/show-add-task-for-date-dialog! ctx target-date))

(defn calendar-page
  ([] (calendar-page {:embedded? false}))
  ([{:keys [embedded?] :or {embedded? false}}]
   (f/widget
    :context ctx
    :get {{color-scheme .-colorScheme} m/Theme}
    :watch [ui-state cal-state/calendar-ui-state
            all-tasks (stream
                       (map stream-util/rows->records)
                       (map stream-util/empty-on-error)
                       :as-values (db/watch-calendar-tasks))
            annivs ann/mock-anniversaries]
    (let [palette       (cal-theme/calendar-theme-palette color-scheme)
          {:keys [current-month selected-date]} ui-state
          tasks-map     (task-logic/group-tasks-by-date-key all-tasks)
          now           (dc/DateTime.now)
          today         (dc/DateTime. (.-year now) (.-month now) (.-day now))
          selected-date (or selected-date today)
          cells         (cal-dates/build-month-cells current-month)
          sel-key       (task-logic/date->key selected-date)
          day-tasks     (get tasks-map sel-key [])
          view-year     (.-year current-month)
          ann-by-key    (ann/anniversaries-by-date-key view-year annivs)
          sel-annivs    (get ann-by-key sel-key [])
          body          (cal-body/calendar-body ctx palette current-month selected-date today cells
                                                  tasks-map ann-by-key day-tasks sel-annivs)]
      (if embedded?
        body
        (m/Scaffold.
         .backgroundColor (:page-bg palette)
         .body body))))))
