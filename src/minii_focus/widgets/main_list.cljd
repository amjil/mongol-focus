(ns minii-focus.widgets.main-list
  (:require [cljd.flutter :as f]
            ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:async" :as async]
            [minii-focus.logic.db :as db]
            [minii-focus.logic.stream-util :as stream-util]
            [minii-focus.state.store :as store]
            [minii-focus.widgets.task-card :as task-card]
            [minii-focus.route-names :as routes]
            [components.tokens :as tokens]))

(defn- title-entry-animation [{:keys [child]}]
  (f/widget
   (m/TweenAnimationBuilder.
    .tween (m/Tween. .begin 0.0 .end 1.0)
    .duration (dart:core/Duration. .milliseconds 800)
    .curve m/Curves.easeOutQuad
    .builder (fn [_ctx value prebuilt-child]
               (m/Opacity.
                .opacity value
                .child (m/Transform.translate
                        .offset (m/Offset. (* -50.0 (- 1.0 value)) 0.0)
                        .child prebuilt-child)))
    .child child)))

(defn- entry-animation [{:keys [child i]}]
  (f/widget
   :let [delay-ms (* i 80)
         duration-ms 600]
   (m/FutureBuilder.
    .future (async/Future.delayed (dart:core/Duration. .milliseconds delay-ms) (fn [] true))
    .builder (fn [_ctx snapshot]
               (if (.-hasData snapshot)
                 (m/TweenAnimationBuilder.
                  .tween (m/Tween. .begin 0.0 .end 1.0)
                  .duration (dart:core/Duration. .milliseconds duration-ms)
                  .curve m/Curves.easeOutCubic
                  .child child
                  .builder (fn [_ctx value child]
                             (m/Opacity.
                              .opacity value
                              .child (m/Transform.translate
                                      .offset (m/Offset. 0.0 (* 25.0 (- 1.0 value)))
                                      .child child))))
                 (m/Opacity. .opacity 0.0 .child child))))))

(defn- empty-state-view [title hint-text]
  (f/widget
   :get {{{primary .-primary} .-colorScheme
          {titleLarge .-titleLarge} .-textTheme} m/Theme}
   (m/Center.
    .child
    (m/Stack.
     .alignment m/Alignment.center
     .children
     [(m/Opacity.
       .opacity 0.03
       .child (m/Icon. m/Icons.filter_vintage .size 240.0))
      (m/Column.
       .mainAxisSize m/MainAxisSize.min
       .children
       [(m/Icon. m/Icons.assignment_turned_in_outlined
                 .color (.withOpacity primary 0.4)
                 .size 48.0)
        (m/Padding. .padding (m/EdgeInsets.only .top (tokens/space :l)))
        (m/Row
         .mainAxisAlignment m/MainAxisAlignment.center
         .children
         [(mgl/MongolText. (str title " - ᠳᠠᠭᠠᠭᠠᠯᠭᠠᠪᠤᠷᠢ ᠪᠠᠢᠬᠤ ᠦᠭᠡᠢ")
                           .style titleLarge
                           .textAlign mgl/MongolTextAlign.center)
          (m/Padding. .padding (m/EdgeInsets.only .top (tokens/space :m)))
          (mgl/MongolText. hint-text
                           .style (m/TextStyle .color m/Colors.grey .fontSize 14.0))])])]))))

(def ^:private mode->title
  {:today "ᠳᠠᠭᠠᠭᠠᠯᠭᠠᠪᠤᠷᠢ"
   :logbook "ᠡᠷᠭᠢᠴᠡᠭᠦᠯᠦᠯ"})

(def ^:private mode->hint
  {:today "ᠰᠢᠨ᠎ᠡ ᠳᠠᠭᠠᠭᠠᠯᠭᠠᠪᠤᠷᠢ ᠨᠡᠮᠡᠨ᠎ᠡ᠎ᠦᠦ"
   :logbook "ᠡᠷᠭᠢᠴᠡᠭᠰᠡᠨ ᠳᠠᠭᠠᠭᠠᠯᠭᠠᠪᠤᠷᠢ ᠪᠠᠢᠬᠤ ᠦᠭᠡᠢ"})

(defn task-stream-view
  "Render horizontal task list. :mode is :today or :logbook."
  [& {:keys [scroll-controller mode]}]
  (f/widget
   :context ctx
   :get {{{primary .-primary} .-colorScheme} m/Theme}
   :watch [{:keys [selected-nav-id]} store/app-ui-state
           tasks (stream
                  (map stream-util/rows->records)
                  (map stream-util/empty-on-error)
                  :as-values (case (or mode (keyword selected-nav-id))
                               :today (db/watch-active-tasks)
                               :logbook (db/watch-logbook)
                               (db/watch-active-tasks)))]
   :let [view-mode (or mode (keyword selected-nav-id) :today)
         display-title (get mode->title view-mode (mode->title :today))
         empty-hint (get mode->hint view-mode (mode->hint :today))]

   (m/AnimatedSwitcher.
    .duration (dart:core/Duration. .milliseconds 400)
    .child
    (if (empty? tasks)
      (m/Container.
       .key (m/ValueKey. (str "empty-" view-mode))
       .child (empty-state-view display-title empty-hint))

      (m/ListView.builder
       .key (m/ValueKey. (str "list-" view-mode))
       .controller scroll-controller
       .scrollDirection m/Axis.horizontal
       .padding (m/EdgeInsets.symmetric .horizontal 30.0)
       .itemCount (inc (count tasks))
       .itemBuilder
       (fn [_ctx i]
         (if (zero? i)
           (title-entry-animation
            {:child (m/Container.
                     .alignment m/Alignment.topLeft
                     .child (mgl/MongolText. display-title
                                             .style (m/TextStyle
                                                     .fontSize 36.0
                                                     .fontWeight m/FontWeight.w900
                                                     .color primary)))})
           (let [task (nth tasks (dec i))]
             (entry-animation
              {:i i
               :child
               (m/Padding.
                .padding (m/EdgeInsets.only .right 12.0 .top 20.0 .bottom 20.0)
                .child
                (task-card/task-item
                 {:id (:id task)
                  :title (:title task)
                  :notes (:notes task)
                  :is-done? (:is-done? task)
                  :subtask-count (:subtask-count task)
                  :subtask-done-count (:subtask-done-count task)
                  :on-tap (fn []
                            (swap! store/app-ui-state assoc :selected-task task)
                            (m/Navigator.pushNamed ctx routes/task-detail))}))})))))))))
